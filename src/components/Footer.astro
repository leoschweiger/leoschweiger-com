---
import { email, footerLinks } from "../scripts/config.js";

const getInTouch = Astro.props.getInTouch || "true";
---

<script>
    import "../scripts/copied.js";
</script>

{
    getInTouch == "true" ? (
        <section
            class="getintouch createsCopyParticle preventSelect"
            onclick={`navigator.clipboard.writeText("${email}")`}
        >
            <h2 class="touch1 createsCopyParticle">get in touch</h2>
            <h2 class="touch2 createsCopyParticle">copy my email</h2>
        </section>
    ) : (
        <div class="space" />
    )
}

<div class="footer fullwidth dark" id="contact">
    <section class="cols c12">
        <div>
            {
                Object.keys(footerLinks).map((link) => (
                    <p>
                        <a
                            href={footerLinks[link as keyof typeof footerLinks]}
                            target="_blank"
                            style="margin: 0"
                        >
                            {link}
                        </a>
                    </p>
                ))
            }
        </div>
        <div
            style="display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-end;"
        >
            <p>
                <a
                    class="legal-links"
                    href="/imprint.txt"
                    target="_blank"
                    style="margin: 0">imprint</a
                >
                <a
                    class="legal-links"
                    href="/privacy.txt"
                    target="_blank"
                    style="margin: 0">privacy</a
                >
            </p>
        </div>
    </section>
</div>
